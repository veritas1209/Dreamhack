# p-1 환경에서의 z의 지수값 (E_1337)
target_mod = p - 1
# E_1337 = (1337 - N) / 2 mod (p-1)
E_1337 = ((1337 - N) // 2) % target_mod

# ==========================================
# 2. Worker 함수 (각 코어가 독립적으로 실행)
# ==========================================
def worker_find_relation(seed):
    # 각 프로세스마다 다른 랜덤 시드 적용
    random.seed(seed)
    
    k = 8
    # 136개의 데이터 중 무작위로 8개 추출
    sampled = random.sample(data, k)
    indices = [item[0] for item in sampled]
    e_vals = [item[1] for item in sampled]
    
    # 격자(Lattice) 기저 행렬 구성
    # 차원: (k + 2) x (k + 2)
    # c_1, ..., c_k, c_z, target(0이 되어야 하는 모듈러 합)
    dim = k + 2
    M = Matrix(ZZ, dim, dim)
    
    # K는 방정식 합이 0이 되도록 강제하는 무거운 가중치(Penalty)
    K = 2^150 
    
    for i in range(k):
        M[i, i] = 1                 # c_i 계수
        M[i, dim-1] = e_vals[i] * K # 방정식에 더해질 e_i 값
        
    M[k, k] = 1                     # c_z 계수
    M[k, dim-1] = E_1337 * K        # z의 지수값 반영
    
    # 모듈러 p-1 을 반영하기 위한 행
    M[k+1, dim-1] = target_mod * K
    
    # LLL 알고리즘 실행
    reduced_M = M.LLL()
    
    # 축소된 기저들 중 유효한 것 찾기
    best_relation = None
    for row in reduced_M:
        # 마지막 열(target)이 0이어야 정확히 mod (p-1)에서 합이 0이 됨
        if row[dim-1] == 0:
            c_vals = list(row[:k])
            c_z = row[k]
            
            # 양수 계수와 음수 계수 카운트
            pos_count = sum(1 for c in c_vals if c > 0)
            neg_count = sum(1 for c in c_vals if c < 0)
            
            # 라이트업 기준: 양수 4개, 음수 4개인 완벽한 밸런스 찾기 
            if pos_count == 4 and neg_count == 4:
                # Sage의 Integer를 Python 표준 int로 변환 (직렬화 오류 방지)
                best_relation = {
                    "indices": [int(idx) for idx in indices],
                    "c_vals": [int(c) for c in c_vals],
                    "c_z": int(c_z)
                }
                break # 좋은 걸 찾았으니 루프 종료
                
    return best_relation

# ==========================================
# 3. 멀티프로세싱 메인 실행부
# ==========================================
if __name__ == "__main__":
    print(f"[*] 7800X3D 풀악셀 가동 준비 완료... (사용 가능 코어: {cpu_count()}개)")
    
    # 워커들에게 넘겨줄 랜덤 시드 (한 번에 10,000번 정도 던져봅니다)
    num_trials = 10000
    seeds = list(range(num_trials))
    
    # 7800X3D의 16스레드를 모두 활용!
    pool = Pool(processes=4)
    
    print("[*] LLL 행렬 무작위 탐색 시작 (이 작업은 양수4/음수4 조합이 나올 때까지 진행됩니다)...")
    
    valid_relations = []
    # imap_unordered를 쓰면 먼저 끝나는 순서대로 결과를 받을 수 있습니다.
    for result in pool.imap_unordered(worker_find_relation, seeds):
        if result is not None:
            print(f"\n[+] 빙고! 완벽한 밸런스의 관계식을 찾았습니다!")
            print(f"    선택된 인덱스: {result['indices']}")
            print(f"    계수 c_i: {result['c_vals']}")
            print(f"    계수 c_z: {result['c_z']}")
            valid_relations.append(result)
            
            # 하나만 찾아도 되지만, 여유 있게 4개 정도 찾고 종료합시다.
            # 이후 평가(Evaluation) 단계에서 가장 작은 차수를 만드는 것을 고르기 위함입니다.
            if len(valid_relations) >= 4:
                pool.terminate()
                break
                
    # 찾은 결과를 JSON으로 저장하여 Step 2 (CUDA 파트)로 넘길 준비 완료
    with open("relations.json", "w") as f:
        json.dump(valid_relations, f, indent=4)
        
    print("\n[*] 저장 완료: relations.json")
    print("[*] 이제 Step 2 (GPU CUDA 연산)로 넘어갈 준비가 되었습니다! 🚀")